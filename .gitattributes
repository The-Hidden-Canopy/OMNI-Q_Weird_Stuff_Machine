# Normalize line endings: LF in the repo, native on checkout
* text=auto

# Force LF for scripts/config regardless of platform
*.sh    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf

# Treat common binary assets as binary
*.png   binary
*.jpg   binary
*.gif   binary
*.pdf   binary
*.safetensors binary
*.ckpt  binary
